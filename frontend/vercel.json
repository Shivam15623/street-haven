{
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://street-haven.onrender.com/api/v1/$1"
    },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
