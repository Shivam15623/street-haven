<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Accident/Incident Report Form</title>
    <script src="/_sdk/element_sdk.js"></script>
    <style>
      * {
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
      }
      body {
        box-sizing: border-box;
        margin: 0;
        padding: 40px 20px;
        background: white;
        font-family: "Arial", "Helvetica", sans-serif;
        width: 100%;
        min-height: 100%;
        color: #000000;
      }

      html {
        height: 100%;
        width: 100%;
      }

      .page-container {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      .form-wrapper {
        background: white;
        border: 3px solid #000000;
        padding: 0;
      }

      .header {
        border-bottom: 3px solid #000000;
        padding: 24px 40px;
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .logo-section {
        flex-shrink: 0;
      }

      .logo {
        display: block;
      }

      .header-text {
        flex: 1;
        text-align: left;
      }

      .organization-name {
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 2px;
        margin: 0 0 8px 0;
        text-transform: uppercase;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .form-content {
        padding: 32px 40px;
      }

      .required-note {
        font-size: 11px;
        font-style: italic;
        margin-bottom: 24px;
        color: #000000;
      }

      .question {
        margin-bottom: 24px;
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .question-label {
        font-size: 12px;
        font-weight: bold;
        margin-bottom: 8px;
        display: block;
      }

      .required {
        color: #000000;
        margin-left: 2px;
      }

      .underline-field {
        border: none;
        border-bottom: 1px solid #000000;
        background: transparent;
        width: 100%;
        padding: 6px 2px;
        font-size: 12px;
        font-family: inherit;
        color: #000000;
      }

      .underline-field:focus {
        outline: none;
        border-bottom: 2px solid #000000;
      }

      .radio-group,
      .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .radio-item,
      .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .radio-button {
        width: 14px;
        height: 14px;
        border: 2px solid #000000;
        border-radius: 50%;
        background: white;
        flex-shrink: 0;
        cursor: pointer;
        position: relative;
      }

      .radio-item input[type="radio"] {
        position: absolute;
        opacity: 0;
        cursor: pointer;
      }

      .radio-item input[type="radio"]:checked + .radio-button::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
        height: 8px;
        background: #000000;
        border-radius: 50%;
      }

      .checkbox-box {
        width: 14px;
        height: 14px;
        border: 2px solid #000000;
        background: white;
        flex-shrink: 0;
        cursor: pointer;
        position: relative;
      }

      .checkbox-item input[type="checkbox"] {
        position: absolute;
        opacity: 0;
        cursor: pointer;
      }

      .checkbox-item input[type="checkbox"]:checked + .checkbox-box::after {
        content: "✓";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 14px;
        font-weight: bold;
        line-height: 1;
      }

      .radio-item label,
      .checkbox-item label {
        font-size: 12px;
        cursor: pointer;
        user-select: none;
      }

      .textarea-box {
        width: 100%;
        min-height: 80px;
        border: 2px solid #000000;
        background: white;
        padding: 10px;
        font-size: 12px;
        font-family: inherit;
        resize: vertical;
        line-height: 1.6;
      }
      .text-content {
        white-space: pre-wrap;
        word-break: break-word;
        min-height: 120px;
      }
      .textarea-box:focus {
        outline: none;
        border: 3px solid #000000;
      }

      .section-divider {
        border-top: 2px solid #000000;
        margin: 32px 0 24px 0;
      }

      .two-column {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }

      @media print {
        .page-container {
          padding: 0;
        }

        .form-wrapper {
          border: 2px solid #000000;
        }
      }

      /* @media (max-width: 768px) {
        .form-content {
          padding: 24px;
        }

        .header {
          padding: 20px 24px;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .header-text {
          text-align: center;
        }

        .header h1 {
          font-size: 20px;
        }

        .two-column {
          grid-template-columns: 1fr;
          gap: 16px;
        }
      } */
    </style>
    <style>
      @view-transition {
        navigation: auto;
      }
    </style>
    <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
    <script src="https://cdn.tailwindcss.com" type="text/javascript"></script>
  </head>
  <body>
    <div class="page-container">
      <div class="form-wrapper">
        <header class="header">
          <div class="logo-section">
            <img class="logo" width="120" height="90" src="{{companyLogo}}" />
          </div>
          <div class="header-text">
            <div class="organization-name" id="org-name">STREET HAVEN</div>
            <h1 id="form-title">EMPLOYEE ACCIDENT/INCIDENT REPORT FORM</h1>
          </div>
        </header>
        <main class="form-content">
          <p class="required-note">* Required</p>
          <!-- Question 1 -->
          <div class="question">
            <label class="question-label"
              >1. I am reporting a work related:
              <span class="required">*</span></label
            >
            <div class="radio-group">
                <div class="radio-item"> <input type="radio" {{#if reportType.injury}}checked{{/if}} />
<div class="radio-button"></div>
<label>Injury</label></div>
                 <div class="radio-item"><input type="radio" {{#if reportType.illness}}checked{{/if}} />
<div class="radio-button"></div>
<label>Illness</label></div>
                  <div class="radio-item"><input type="radio" {{#if reportType.nearMiss}}checked{{/if}} />
<div class="radio-button"></div>
<label>Near Miss</label></div>
             




            </div>
          </div>
          <!-- Question 2 -->
          <div class="question">
            <label class="question-label" for="your-name"
              >2. Employee Name <span class="required">*</span></label
            >
         <input class="underline-field" value="{{employeeName}}" readonly />
          </div>
          <!-- Question 3 -->
          <div class="question">
            <label class="question-label" for="job-title">3. Job Title</label>
      <input class="underline-field" value="{{jobTitle}}" readonly />
          </div>
          <!-- Question 4 -->
          <div class="question">
            <label class="question-label" for="supervisor"
              >4. Supervisor <span class="required">*</span></label
            >
    <input class="underline-field" value="{{supervisorName}}" readonly />
          </div>
          <!-- Question 5 -->
          <div class="question">
            <label class="question-label"
              >5. Have you told your supervisor about this injury/near miss?
              <span class="required">*</span></label
            >
            <div class="radio-group">
              <div class="radio-item">
               <input type="radio" {{#if informedSupervisor.yes}}checked{{/if}} />
<div class="radio-button"></div>
<label>Yes</label>
              </div>
              <div class="radio-item">
               <input type="radio" {{#if informedSupervisor.no}}checked{{/if}} />
<div class="radio-button"></div>
<label>No</label>
              </div>
            </div>
          </div>
          <!-- Question 6 & 7 -->
          <div class="two-column">
            <div class="question">
              <label class="question-label" for="date-injury"
                >6. Date of Injury/Near Miss
                <span class="required">*</span></label
              >
              <input class="underline-field" value="{{injuryDate}}" readonly />
            </div>
            <div class="question">
              <label class="question-label" for="time-injury"
                >7. Time of injury/near miss
                <span class="required">*</span></label
              >
            <input class="underline-field" value="{{injuryTime}}" readonly />
            </div>
          </div>
          <!-- Question 8 -->
          <div class="question">
            <label class="question-label" for="witness"
              >8. Name of Witness (if any)</label
            >
            <input type="text" id="witness" class="underline-field" value="{{#each witnesses}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}" readonly />
          </div>
          <!-- Question 9 -->
          <div class="question">
            <label class="question-label" for="location"
              >9. Where, exactly did it happen?
              <span class="required">*</span></label
            >
            <input type="text" id="location" class="underline-field" value="{{location}}" />
          </div>
          <!-- Question 10 -->
          <div class="question">
            <label class="question-label" for="activity"
              >10. What were you doing at the time?
              <span class="required">*</span></label
            >
           <div class="textarea-box text-content">
  {{activityAtTime}}
</div>
          </div>
          <!-- Question 11 -->
          <div class="question">
            <label class="question-label" for="description"
              >11. Describe step by step what led up to the injury/near miss
              <span class="required">*</span></label
            >
       
<div class="textarea-box text-content">
  {{description}}
</div>
          </div>
          <!-- Question 12 -->
          <div class="question">
            <label class="question-label" for="prevention"
              >12. What could have been done to prevent this injury/near miss?
              <span class="required">*</span></label
            >
        <div class="textarea-box text-content">
  {{preventionSuggestion}}
</div>
          </div>
          <!-- Question 13 -->
          <div class="question">
            <label class="question-label" for="body-parts"
              >13. What parts of your body were injured? If a near miss, how
              could you have been hurt?</label
            >
           
<div class="textarea-box text-content">
  {{injuredBodyPartOrRisk}}
</div>
          </div>
          <div class="section-divider"></div>
          <!-- Question 14 -->
          <div class="question">
            <label class="question-label"
              >14. Did you see a doctor about this injury/illness?</label
            >
            <div class="radio-group">
              <div class="radio-item">
                <input type="radio" {{#if sawDoctor.yes}}checked{{/if}} />
<div class="radio-button"></div>
<label>Yes</label>
              </div>
              <div class="radio-item">
                
<input type="radio" {{#if sawDoctor.no}}checked{{/if}} />
<div class="radio-button"></div>
<label>No</label>
              </div>
            </div>
          </div>
          <!-- Question 15 -->
          <div class="question">
            <label class="question-label" for="doctor-name"
              >15. If yes, whom did you see?</label
            >
          <input class="underline-field" value="{{doctorName}}" readonly />
          </div>
          <!-- Question 16 -->
          <div class="question">
            <label class="question-label" for="doctor-phone"
              >16. Doctor's phone number</label
            >
          <input class="underline-field" value="{{doctorPhone}}" readonly />
          </div>
          <!-- Question 17 & 18 -->
          <div class="two-column">
            <div class="question">
              <label class="question-label" for="visit-date">17. Date</label>
       <input class="underline-field" value="{{doctorVisitDate}}" readonly />
            </div>
            <div class="question">
              <label class="question-label" for="visit-time">18. Time</label>
             <input class="underline-field" value="{{doctorVisitTime}}" readonly />
            </div>
          </div>
          <!-- Question 19 -->
          <div class="question">
            <label class="question-label"
              >19. Has this part of your body been injured before?</label
            >
            <div class="radio-group">
              <div class="radio-item">
             <input type="radio" {{#if previousInjury.yes}}checked{{/if}} />
<div class="radio-button"></div>
<label>Yes</label>

              </div>
              <div class="radio-item">
                <input type="radio" {{#if previousInjury.no}}checked{{/if}} />
<div class="radio-button"></div>
<label>No</label>
              </div>
            </div>
          </div>
          <!-- Question 20 -->
          <div class="question">
            <label class="question-label" for="previous-when"
              >20. If yes, when?</label
            >
          <input class="underline-field" value="{{previousInjuryDate}}" readonly />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
