<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Client Feedback Form</title>
    <style>
      * { box-decoration-break: clone; -webkit-box-decoration-break: clone; }
      body { box-sizing: border-box; margin: 0; padding: 40px 20px; background:
      white; font-family: "Arial", "Helvetica", sans-serif; width: 100%;
      min-height: 100%; color: #000000; } html { height: 100%; width: 100%; }
      .page-container { width: 100%; max-width: 900px; margin: 0 auto; padding:
      40px 20px; } .form-wrapper { background: white; border: 3px solid #000000;
      padding: 0; } .header { border-bottom: 3px solid #000000; padding: 24px
      40px; display: flex; align-items: center; gap: 32px; } .logo-section {
      flex-shrink: 0; } .logo { display: block; } .header-text { flex: 1;
      text-align: left; } .organization-name { font-size: 11px; font-weight:
      bold; letter-spacing: 2px; margin: 0 0 8px 0; text-transform: uppercase; }
      .header h1 { margin: 0 0 12px 0; font-size: 24px; font-weight: bold;
      letter-spacing: 1px; text-transform: uppercase; border-bottom: 2px solid
      #000000; padding-bottom: 12px; } .header p { margin: 12px 0 0 0;
      font-size: 12px; line-height: 1.5; font-style: italic; } .form-content {
      padding: 32px 40px; } .section { margin-bottom: 28px; border-bottom: 1px
      solid #000000; padding-bottom: 20px; page-break-inside: avoid;
      break-inside: avoid; } .section:last-of-type { border-bottom: none; }
      .section-title { font-size: 14px; font-weight: bold; margin: 0 0 16px 0;
      text-transform: uppercase; letter-spacing: 0.5px; } .subsection-label {
      font-size: 12px; font-weight: bold; margin: 0 0 12px 0; text-decoration:
      underline; } .field-group { margin-bottom: 16px; } .field-label { display:
      inline-block; font-size: 11px; font-weight: bold; margin-bottom: 4px;
      text-transform: uppercase; letter-spacing: 0.3px; } .underline-field {
      border: none; border-bottom: 1px solid #000000; background: transparent;
      width: 100%; padding: 6px 2px; font-size: 12px; font-family: inherit;
      color: #000000; } .underline-field:focus { outline: none; border-bottom:
      2px solid #000000; } .inline-field { display: flex; align-items: baseline;
      gap: 8px; margin-bottom: 10px; } .inline-label { font-size: 11px;
      font-weight: bold; white-space: nowrap; } .inline-input { flex: 1; border:
      none; border-bottom: 1px solid #000000; background: transparent; padding:
      4px 2px; font-size: 12px; } .inline-input:focus { outline: none;
      border-bottom: 2px solid #000000; } .two-column { display: grid;
      grid-template-columns: 1fr 1fr; gap: 24px; } .checkbox-group { display:
      flex; flex-direction: column; gap: 8px; margin-bottom: 8px; }
      .checkbox-item { display: flex; align-items: center; gap: 8px; }
      .checkbox-box { width: 14px; height: 14px; border: 2px solid #000000;
      background: white; flex-shrink: 0; cursor: pointer; position: relative; }
      .checkbox-item input[type="checkbox"] { position: absolute; opacity: 0;
      cursor: pointer; } .checkbox-item input[type="checkbox"]:checked +
      .checkbox-box::after { content: "✓"; position: absolute; top: 50%; left:
      50%; transform: translate(-50%, -50%); font-size: 14px; font-weight: bold;
      line-height: 1; } .checkbox-item label { font-size: 12px; cursor: pointer;
      user-select: none; } .textarea-box { width: 100%; min-height: 100px;
      border: 2px solid #000000; background: white; padding: 10px; font-size:
      12px; font-family: inherit; resize: vertical; line-height: 1.6; }
      .textarea-box:focus { outline: none; border: 3px solid #000000; }
      .text-content { white-space: pre-wrap; word-break: break-word; min-height:
      120px; } .helper-text { font-size: 11px; font-style: italic;
      margin-bottom: 8px; } .signature-section { margin-top: 32px; padding-top:
      24px; border-top: 2px solid #000000; } @media print { .page-container {
      padding: 0; } .form-wrapper { border: 2px solid #000000; } } /* @media
      (max-width: 768px) { .form-content { padding: 24px; } .header { padding:
      20px 24px; flex-direction: column; align-items: center; text-align:
      center; } .header-text { text-align: center; } .header h1 { font-size:
      20px; } .two-column { grid-template-columns: 1fr; gap: 16px; } } */
    </style>
    <style>
      @view-transition { navigation: auto; }
    </style>
    <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
    <script src="/_sdk/element_sdk.js" type="text/javascript"></script>
    <script src="https://cdn.tailwindcss.com" type="text/javascript"></script>
  </head>
  <body>
    
    <div class="page-container">
      <div class="form-wrapper">
        <header class="header">
          <div class="logo-section">
            <img class="logo" width="120" height="90" src="{{companyLogo}}" />
          </div>
          <div class="header-text">
            <div class="organization-name">STREET HAVEN</div>
            <h1>CLIENT FEEDBACK FORM</h1>
            <p>
              Thank you for visiting Street Haven. We value all our clients and
              strive to meet everyone's needs.
            </p>
          </div>
        </header>
        <main class="form-content">
          <!-- Section 1: Date and Location -->
          <section class="section">
            <h2 class="section-title">1. Date and Location of Visit</h2>
            <div class="inline-field">
              <span class="inline-label">Date:</span>
              <input class="inline-input" value="{{visitDate}}" readonly />
            </div>
            <div class="inline-field">
              <span class="inline-label">Location:</span>
              <input class="inline-input" value="{{visitLocation}}" readonly />
            </div>
          </section>
          <!-- Client Information -->
      <section class="section">
  <h3 class="subsection-label">
    Client Information (optional if anonymous)
  </h3>

  <div class="inline-field">
    <span class="inline-label">Name:</span>
    <input class="inline-input" value="{{clientName}}" readonly />
  </div>

  <div class="inline-field">
    <span class="inline-label">Phone:</span>
    <input class="inline-input" value="{{clientPhone}}" readonly />
  </div>

  <div class="inline-field">
    <span class="inline-label">Email:</span>
    <input class="inline-input" value="{{clientEmail}}" readonly />
  </div>

  <div class="field-group">
    <span class="field-label">Address</span>
    <div class="textarea-box text-content">{{clientAddress}}</div>
  </div>

  <div class="inline-field">
    <span class="inline-label">Preferred Method of Contact:</span>
    <input class="inline-input" value="{{preferredContactMethod}}" readonly />
  </div>
</section>

          <!-- Section 2: Nature of Complaint -->
   <section class="section">
  <h2 class="section-title">2. Nature of the Complaint</h2>

  <div class="checkbox-group">
    <div class="checkbox-item">
      <input type="checkbox" {{#if complaintNature.service}}checked{{/if}} />
      <div class="checkbox-box"></div>
      <label>Service Issue</label>
    </div>

    <div class="checkbox-item">
      <input type="checkbox" {{#if complaintNature.staff}}checked{{/if}} />
      <div class="checkbox-box"></div>
      <label>Staff Behaviour</label>
    </div>

    <div class="checkbox-item">
      <input type="checkbox" {{#if complaintNature.product}}checked{{/if}} />
      <div class="checkbox-box"></div>
      <label>Product Issue</label>
    </div>

    <div class="checkbox-item">
      <input type="checkbox" {{#if complaintNature.other}}checked{{/if}} />
      <div class="checkbox-box"></div>
      <label>Other</label>
    </div>
  </div>

  {{#if complaintNature.other}}
  <div class="field-group">
    <span class="field-label">Please Specify</span>
    <div class="textarea-box text-content">{{otherComplaintText}}</div>
  </div>
  {{/if}}
</section>

          <!-- Section 3: Description -->
          <section class="section">
            <h2 class="section-title">3. Description of the Complaint</h2>
            <div
              class="textarea-box text-content"
              placeholder=""
            >{{desiredOutcome}}</div>
          </section>
          <!-- Section 4: Impact -->
          <section class="section">
            <h2 class="section-title">4. Impact</h2>
            <p class="helper-text">How has this issue affected you?</p>
            <div
              class="textarea-box text-content"
              placeholder=""
            >{{desiredOutcome}}</div>
          </section>
          <!-- Section 5: Desired Outcome -->
          <section class="section">
            <h2 class="section-title">5. Desired Outcome</h2>
            <p class="helper-text">
              What would you like to see happen as a result of your complaint?
            </p>
            <div
              class="textarea-box text-content"
              placeholder=""
            >{{desiredOutcome}}</div>
          </section>
          <!-- Section 6: Signature -->
          <section class="signature-section">
            <h2 class="section-title">6. Signature (optional)</h2>
            <div class="two-column">
              <div class="inline-field">
                <span class="inline-label">Signature:</span>
                <input type="text" class="inline-input" placeholder="" />
              </div>
              <div class="inline-field">
                <span class="inline-label">Date:</span>
                <input type="text" class="inline-input" placeholder="" />
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>