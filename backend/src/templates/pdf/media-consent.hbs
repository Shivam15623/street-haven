<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Media Consent Form</title>
    <script src="/_sdk/element_sdk.js"></script>
    <style>
      * {
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
      }
      body {
        box-sizing: border-box;
        margin: 0;
        padding: 40px 20px;
        background: white;
        font-family: "Arial", "Helvetica", sans-serif;
        width: 100%;
        min-height: 100%;
        color: #000000;
      }

      html {
        height: 100%;
        width: 100%;
      }

      .page-container {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      .form-wrapper {
        background: white;
        border: 3px solid #000000;
        padding: 0;
      }

      .header {
        border-bottom: 3px solid #000000;
        padding: 24px 40px;
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .logo-section {
        flex-shrink: 0;
      }

      .logo {
        display: block;
      }

      .header-text {
        flex: 1;
        text-align: left;
      }

      .organization-name {
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 2px;
        margin: 0 0 8px 0;
        text-transform: uppercase;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .form-content {
        padding: 32px 40px;
      }

      .intro-paragraph {
        font-size: 12px;
        line-height: 1.6;
        margin-bottom: 20px;
      }

      .name-line {
        display: inline-block;
        border-bottom: 1px solid #000000;
        min-width: 300px;
        margin: 0 4px;
      }

      .section {
        margin-bottom: 24px;
        page-break-inside: avoid;
        break-inside: avoid;
      }

      .section-title {
        font-size: 13px;
        font-weight: bold;
        margin: 0 0 12px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .bullet-list {
        margin: 0 0 16px 20px;
        padding: 0;
      }

      .bullet-list li {
        font-size: 12px;
        line-height: 1.6;
        margin-bottom: 8px;
      }

      .sub-bullet-list {
        margin: 6px 0 0 20px;
        padding: 0;
        list-style-type: circle;
      }

      .sub-bullet-list li {
        font-size: 11px;
        line-height: 1.5;
        margin-bottom: 4px;
      }

      .section-divider {
        border-top: 2px solid #000000;
        margin: 28px 0 24px 0;
      }

      .acknowledgment-section {
        background: #f5f5f5;
        border: 2px solid #000000;
        padding: 20px;
        margin: 24px 0;
      }

      .acknowledgment-title {
        font-size: 14px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0 0 16px 0;
        text-align: center;
      }

      .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
      }

      .checkbox-box {
        width: 14px;
        height: 14px;
        border: 2px solid #000000;
        background: white;
        flex-shrink: 0;
        cursor: pointer;
        position: relative;
        margin-top: 2px;
      }

      .checkbox-item input[type="checkbox"] {
        position: absolute;
        opacity: 0;
        cursor: pointer;
      }

      .checkbox-item input[type="checkbox"]:checked + .checkbox-box::after {
        content: "✓";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 14px;
        font-weight: bold;
        line-height: 1;
      }

      .checkbox-item label {
        font-size: 11px;
        cursor: pointer;
        user-select: none;
        line-height: 1.5;
      }

      .signature-section {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 2px solid #000000;
      }

      .signature-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 20px;
      }

      .signature-field {
        display: flex;
        flex-direction: column;
      }

      .field-label {
        font-size: 11px;
        font-weight: bold;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
      }

      .underline-field {
        border: none;
        border-bottom: 1px solid #000000;
        background: transparent;
        width: 100%;
        padding: 6px 2px;
        font-size: 12px;
        font-family: inherit;
        color: #000000;
      }

      .underline-field:focus {
        outline: none;
        border-bottom: 2px solid #000000;
      }

      .text-content {
        white-space: pre-wrap;
        word-break: break-word;
        min-height: 120px;
      }

      @media print {
        .page-container {
          padding: 0;
        }

        .form-wrapper {
          border: 2px solid #000000;
        }
      }

      /* @media (max-width: 768px) {
        .form-content {
          padding: 24px;
        }

        .header {
          padding: 20px 24px;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .header-text {
          text-align: center;
        }

        .header h1 {
          font-size: 20px;
        }

        .signature-row {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .name-line {
          display: block;
          margin: 8px 0;
        }
      } */
    </style>
    <style>
      @view-transition {
        navigation: auto;
      }
    </style>
    <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
    <script src="https://cdn.tailwindcss.com" type="text/javascript"></script>
  </head>
  <body>
    <div class="page-container">
      <div class="form-wrapper">
        <header class="header">
          <div class="logo-section">
            <img class="logo" width="120" height="90" src="{{companyLogo}}" />
          </div>
          <div class="header-text">
            <div class="organization-name" id="org-name">STREET HAVEN</div>
            <h1 id="form-title">MEDIA CONSENT FORM</h1>
          </div>
        </header>
        <main class="form-content">
          <p class="intro-paragraph">
            I,
            <input
              type="text"
              class="name-line"
              id="participant-name"
              placeholder=""
              value="{{name}}"
            />, understand that I may be asked to participate in various
            media-related activities including but not limited to:
          </p>
          <!-- Media Activities Section -->
          <section class="section">
            <ul class="bullet-list">
              <li>
                <strong>Photography:</strong> Use my photograph in print
                publications, online materials, and promotional content.
              </li>
              <li>
                <strong>Video Recording:</strong> Record video footage of me
                including but not limited to:
                <ul class="sub-bullet-list">
                  <li>Training materials</li>
                  <li>Promotional videos</li>
                  <li>Virtual event presentations</li>
                  <li>Social media content</li>
                </ul>
              </li>
              <li>
                <strong>Audio Recording:</strong> Record my voice for:
                <ul class="sub-bullet-list">
                  <li>Promotional materials</li>
                  <li>Training resources</li>
                  <li>Podcast appearances</li>
                  <li>Media interviews</li>
                </ul>
              </li>
              <li>
                <strong>Written Materials:</strong> Use my name, position title,
                and written statements in:
                <ul class="sub-bullet-list">
                  <li>Organizational publications</li>
                  <li>Grant applications</li>
                  <li>Website content</li>
                  <li>Media releases</li>
                </ul>
              </li>
              <li>
                <strong>Social Media:</strong> Feature my image, name, and
                work-related content on the organization's social media
                platforms.
              </li>
            </ul>
          </section>
          <div class="section-divider"></div>
          <!-- I Understand Section -->
          <section class="section">
            <h2 class="section-title">I understand that:</h2>
            <ul class="bullet-list">
              <li>
                Street Haven at the Crossroads may use approved media content
                for promotional, educational, and fundraising purposes.
              </li>
              <li>
                Content may be used across multiple platforms and materials
                without additional consent
              </li>
              <li>
                I will not receive compensation for the use of my likeness or
                statements.
              </li>
              <li>
                The organization retains the right to edit content for length,
                clarity, and appropriateness.
              </li>
              <li>
                I may request removal of content, though the organization cannot
                guarantee removal from all previously distributed materials.
              </li>
            </ul>
          </section>
          <!-- This Consent Section -->
          <section class="section">
            <h2 class="section-title">This consent:</h2>
            <ul class="bullet-list">
              <li>
                Remains in effect throughout my employment unless revoked in
                writing.
              </li>
              <li>
                May be modified or revoked by me at any time with 30 days
                written notice.
              </li>
              <li>
                Will be reviewed annually or upon significant role changes.
              </li>
              <li>
                May be limited by the organization for safety or operational
                reasons.
              </li>
            </ul>
          </section>
          <div class="section-divider"></div>
          <!-- Staff Acknowledgment -->
          <div class="acknowledgment-section">
            <h3 class="acknowledgment-title">STAFF ACKNOWLEDGMENT</h3>
            <p style="font-size: 12px; margin-bottom: 16px; line-height: 1.6">
              By signing below, I acknowledge that:
            </p>
            <ul
              class="bullet-list"
              style="margin-left: 20px; list-style-type: disc"
            >
              <li>I have read and understood this consent form</li>
              <li>I have been given the opportunity to ask questions</li>
              <li>
                I understand my rights regarding personal information and media
                use
              </li>
              <li>
                I understand the unique confidentiality requirements of working
                in a women's shelter
              </li>
              <li>I can modify or revoke this consent at any time</li>
              <li>I am signing this voluntarily without coercion</li>
            </ul>
          </div>
          <!-- Signature Section -->
          <section class="signature-section">
            <div class="signature-row">
              <div class="signature-field">
                <label class="field-label" for="signature"
                  >Staff Signature:</label
                >
                <input type="text" id="signature" class="underline-field" />
              </div>
              <div class="signature-field">
                <label class="field-label" for="date">Date:</label>
                <input type="text" id="date" class="underline-field" value="{{date}}" />
              </div>
            </div>
            <div class="signature-field">
              <label class="field-label" for="printed-name"
                >Printed Name:</label
              >
              <input type="text" id="printed-name" class="underline-field" value="{{printedname}}" />
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
