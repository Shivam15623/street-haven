<html>
  <head>
    <style>
      body { font-family: Arial, sans-serif; font-size: 12px; color: #333;
      margin: 20px; } h2 { text-align: center; color: #1a237e; margin-bottom:
      20px; } p { margin: 6px 0; } .info { margin-bottom: 15px; } table { width:
      100%; border-collapse: collapse; margin-top: 10px; box-shadow: 0 0 5px
      rgba(0,0,0,0.1); } th, td { border: 1px solid #aaa; padding: 8px;
      text-align: left; } th { background-color: #f2f2f2; color: #000;
      font-weight: bold; } tr:nth-child(even) td { background-color: #f9f9f9; }
      .logo { display: block; margin: 20px auto; width: 150px; height: auto;  }
      .total { margin-top: 15px; font-weight: bold; font-size: 14px; text-align:
      right; } .header{ position: relative;
      width: 100%; } .title{ flex: 1; }
    </style>
  </head>
  <body>
    <!-- Company Logo -->
    <div class="header">
      <img src="{{companyLogo}}" alt="Company Logo" class="logo" />
      <h2 >Payment Requisition Form</h2>
    </div>

    <div class="info">
      <p><b>Payee Name:</b> {{payeeName}}</p>
      <p><b>Date:</b> {{date}}</p>
      <p><b>Requested By:</b> {{requestedBy}}</p>
      <p><b>Approved By:</b> {{approvedBy}}</p>
    </div>

    <table>
      <thead>
        <tr>
          <th>Purchase Date</th>
          <th>Nature</th>
          <th>Program</th>
          <th>Expense Code</th>
          <th>Net Amount</th>
          <th>HST</th>
          <th>Total Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each paymentDetails}}
          <tr>
            <td>{{purchaseDate}}</td>
            <td>{{purchaseNature}}</td>
            <td>{{program}}</td>
            <td>{{expenseCode}}</td>
            <td>{{netAmount}}</td>
            <td>{{hst}}</td>
            <td>{{totalAmount}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <p class="total">Grand Total: {{totalAmount}}</p>
  </body>
</html>